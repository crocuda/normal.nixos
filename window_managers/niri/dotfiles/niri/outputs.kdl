/* 
* Per output layout
*/

/// Desktop
output "DP-2" {
  layout {
    // Col/Row
    default-column-width {
      proportion 0.3
    }
    preset-column-widths {
      proportion 0.2
      proportion 0.3
      proportion 0.5
      proportion 0.6
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    struts {
      top 30
      // left 100
      // right 40
      left 500
      right 500
      bottom 90
    }
  }
}
/// Laptop
output "eDP-1" {
  layout {
    // Col/Row
    default-column-width {
      proportion 0.5
    }
    preset-column-widths {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.5
      proportion 1.0
    }
    struts {
      top 10
      left 40
      right 20
      bottom 30
    }
  }
}
/// TV
output "HDMI-A-1" {
  scale 2.2
  layout {
    // Col/Row
    default-column-width {
      proportion 0.5
    }
    preset-column-widths {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.5
      proportion 1.0
    }
    struts {
      top 10
      left 40
      right 20
      bottom 30
    }
  }
}
