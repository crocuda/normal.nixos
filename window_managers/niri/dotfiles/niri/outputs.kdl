/// Default laptop
output "eDP-1" {
  layout {
    // Col/Row
    default-column-width {
      proportion 0.5
    }
    preset-column-widths {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.3
      proportion 0.5
      proportion 1.0
    }
    struts {
      top 10
      left 40
      right 20
      bottom 30
    }
  }
}

// Tv
// Keep extra spaces in name
output "Samsung Electric Company SAMSUNG 0x01000E00" {
  scale 2.2
  layout {
    // Col/Row
    default-column-width {
      proportion 0.5
    }
    preset-column-widths {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    struts {
      top 10
      left 20
      right 5
      bottom 30
    }
  }
}
// KB Tv
// Keep extra spaces in name
output "Mars-Tech Corporation Smart TV    0x00000001" {
  scale 1.2
  layout {
    // Col/Row
    default-column-width {
      proportion 0.5
    }
    preset-column-widths {
      proportion 0.3
      proportion 0.5
      proportion 0.7
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.5
      proportion 1.0
    }
    struts {
      top 10
      left 40
      right 20
      bottom 30
    }
  }
}

