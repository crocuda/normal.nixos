/* 
* Per output layout
*/

/// Default desktop
output "DP-2" {
  layout {
    // Col/Row
    default-column-width {
      proportion 0.3
    }
    // default-column-height {
    //  proportion 0.66
    // }
    preset-column-widths {
      proportion 0.2
      proportion 0.3
      proportion 0.5
      proportion 0.65
      proportion 0.85
      proportion 1.0
    }
    preset-window-heights {
      proportion 0.33
      proportion 0.5
      proportion 0.66
      proportion 1.0
    }
    struts {
      top 30
      left 200
      right 40
      bottom 90
    }
  }
}
